<view class="page">
  <view class="section" wx:if="{{!online}}">
    <view class="row"><view>当前：{{statusLabel}}</view></view>
    <view class="hint">后端没连上时，下单只记在手机本地（不会真的进系统）。请在「我的」里设置后端地址。</view>
  </view>

  <view class="empty" wx:if="{{empty}}">
    购物车是空的
    <view style="margin-top:24rpx"><view class="btn btn-primary" bindtap="goIndex">去逛逛</view></view>
  </view>

  <block wx:if="{{!empty}}">
    <view class="section">
      <view class="section-title">商品（{{lines.length}} 种）</view>
      <view class="line" wx:for="{{lines}}" wx:key="code">
        <view class="thumb">{{item.emoji}}</view>
        <view class="line-info">
          <view class="name">{{item.name}}</view>
          <view class="muted">{{item.spec}} · ¥{{item.priceText}}/{{item.unit}}</view>
        </view>
        <view class="stepper">
          <view class="step" data-code="{{item.code}}" data-delta="-1" bindtap="onQty">−</view>
          <view class="qty">{{item.qty}}</view>
          <view class="step" data-code="{{item.code}}" data-delta="1" bindtap="onQty">+</view>
        </view>
        <view class="amount">¥{{item.amountText}}</view>
      </view>
      <view class="row"><view class="muted" bindtap="onClear">清空购物车</view></view>
    </view>

    <view class="section">
      <view class="section-title">配送方式</view>
      <view class="kinds">
        <view class="kind {{deliveryType === 'delivery' ? 'on' : ''}}" data-kind="delivery" bindtap="onDelivery">送货上门</view>
        <view class="kind {{deliveryType === 'pickup' ? 'on' : ''}}" data-kind="pickup" bindtap="onDelivery">到店自提</view>
      </view>
      <view class="muted" style="margin-top:12rpx">{{feeHint}}</view>
    </view>

    <view class="section">
      <view class="section-title">收货信息</view>
      <view class="field">
        <view class="field-label">收货人</view>
        <input class="input" placeholder="姓名 / 称呼" value="{{name}}" bindinput="onName" />
      </view>
      <view class="field">
        <view class="field-label">手机号（11 位）</view>
        <input class="input" type="number" maxlength="11" placeholder="方便老板联系" value="{{phone}}" bindinput="onPhone" />
      </view>
      <view class="field" wx:if="{{deliveryType === 'delivery'}}">
        <view class="field-label">送货地址</view>
        <input class="input" placeholder="小区 / 楼栋 / 门牌" value="{{address}}" bindinput="onAddress" />
      </view>
      <view class="muted" wx:else>自提地址与时间由老板在订单里回复（熟客也可直接到店自取）。</view>
    </view>

    <view class="section">
      <view class="row"><view>商品小计</view><view>¥{{subtotalText}}</view></view>
      <view class="row"><view>配送费</view><view>¥{{feeText}}</view></view>
      <view class="row total"><view>合计</view><view>¥{{totalText}}</view></view>
      <view class="btn btn-primary btn-block {{submitting ? 'dis' : ''}}" bindtap="submit">{{submitting ? '提交中…' : '提交订单'}}</view>
      <view class="muted" style="margin-top:12rpx">提交后以店老板确认为准；第一版为到店付款 / 货到付款，微信支付待商户号开通。</view>
    </view>
  </block>
</view>
