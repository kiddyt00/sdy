.oid { font-size: 24rpx; color: #6b7280; }
.items { font-size: 27rpx; padding: 12rpx 0; }
.total { color: #dc2626; font-weight: 700; font-size: 30rpx; }
.ops { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.pill {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
}
.pill.st-pending { background: #fef3c7; color: #92400e; }
.pill.st-delivering { background: #dbeafe; color: #1d4ed8; }
.pill.st-ready { background: #ede9fe; color: #5b21b6; }
.pill.st-done { background: #dcfce7; color: #166534; }
.pill.st-cancelled { background: #f3f4f6; color: #9ca3af; }
