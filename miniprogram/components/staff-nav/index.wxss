/* 员工端底栏（第 26 轮 / D32）：固定在最下面，5 个等宽入口 */
.snav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  background: #fff;
  border-top: 1rpx solid #f0f1f3;
  padding: 10rpx 0 6rpx;
  padding-bottom: calc(10rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
}
.si {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.st {
  font-size: 21rpx;
  color: #9ca3af;
  line-height: 30rpx;
}
.si.on .st {
  color: #16a34a;
  font-weight: 600;
}
