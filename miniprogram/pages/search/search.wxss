@import "../../styles/state.wxss";

/* 搜索页（第 24 轮） */
.spage { padding: 0 24rpx 40rpx; }

.sbar {
  display: flex;
  align-items: center;
  padding: 16rpx 0 8rpx;
}
.sbox {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  min-width: 0;
}
.sinput {
  flex: 1;
  font-size: 28rpx;
  margin: 0 14rpx;
  min-width: 0;
}
.sph { color: #b6bac2; }
.scancel {
  font-size: 28rpx;
  color: #16a34a;
  padding-left: 24rpx;
}

.ssec { margin-top: 28rpx; }
.ssec-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 18rpx;
}
.swrap { display: flex; flex-wrap: wrap; }
.sword {
  font-size: 26rpx;
  color: #4b5563;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin: 0 18rpx 18rpx 0;
}
.sword.hot { color: #15803d; background: #dcfce7; }

.scount {
  font-size: 23rpx;
  color: #9ca3af;
  margin: 20rpx 0 16rpx;
}
.slist { margin-top: 8rpx; }

/* 第 27 轮 P0-7：搜索页也放一个购物车入口，让加购后的件数在搜索页就能看见 */
.scart {
  position: relative;
  padding: 6rpx 0 6rpx 18rpx;
  display: flex;
  align-items: center;
}
.scart-n {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #16a34a;
  color: #fff;
  font-size: 20rpx;
  padding: 0 6rpx;
}

