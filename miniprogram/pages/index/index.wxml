<view class="page">
  <view class="bar">
    <view class="badge {{online ? 'ok' : 'off'}}">{{statusLabel}}</view>
    <input class="search" placeholder="搜商品名 / 品牌 / 条码" value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
    <view class="scan" bindtap="onScan">扫码</view>
  </view>

  <scroll-view class="chips" scroll-x enable-flex>
    <view wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'on' : ''}}" data-cat="{{item}}" bindtap="onCategory">{{item}}</view>
  </scroll-view>

  <view class="hint" wx:if="{{!online}}">{{statusDetail}}</view>

  <view class="list">
    <view class="card" wx:for="{{products}}" wx:key="code">
      <view class="thumb">{{item.emoji}}</view>
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="spec">{{item.spec}}{{item.brand ? ' · ' + item.brand : ''}}</view>
        <view class="price">¥{{item.priceText}}<text class="unit"> /{{item.unit}}</text>
          <text class="stock {{item.stock <= 0 ? 'zero' : ''}}">库存 {{item.stock}}</text>
        </view>
      </view>
      <view class="btn btn-primary btn-mini {{item.stock <= 0 ? 'dis' : ''}}" data-code="{{item.code}}" bindtap="onAdd">加入</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!products.length}}">没有找到商品，换个词试试</view>

  <view class="cartbar" wx:if="{{cartCount > 0}}">
    <view class="cb-left"><text class="cb-num">{{cartCount}}</text> 件 · 合计 ¥{{cartAmountText}}</view>
    <view class="cb-go" bindtap="goCart">去购物车</view>
  </view>
</view>
