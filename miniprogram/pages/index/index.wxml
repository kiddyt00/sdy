<wxs src="../../utils/tools.wxs" module="tools" />
<view class="page">
  <!-- 店铺条 -->
  <view class="shopbar">
    <view class="sb-l">
      <view class="sb-name">{{shop.name}}</view>
      <view class="sb-sub">{{online ? '送货上门 · 到店自提' : '本地演示模式'}}</view>
    </view>
    <!-- 连接状态只留一个小绿点（离线为灰点），不占地方也不露开发信息 -->
    <view class="cdot sdot {{online ? 'ok' : 'off'}}"></view>
  </view>

  <!-- 搜索 + 扫码（扫码只读：只查货，不加购） -->
  <view class="searchbar">
    <view class="sbox" bindtap="goSearch">
      <van-icon name="search" size="30rpx" color="#9ca3af" />
      <text class="sph">搜商品名 / 条码</text>
    </view>
    <view class="scan" bindtap="onScan">扫码</view>
  </view>

  <!-- 扫码 / 搜索后的筛选提示 -->
  <view class="kwbar" wx:if="{{keyword}}">
    <text class="kwt">筛选：{{keyword}}</text>
    <text class="kwx" bindtap="clearKeyword">清除</text>
  </view>

  <van-notice-bar
    wx:if="{{shop.address}}"
    left-icon="location-o"
    text="{{shop.address}}"
    bind:click="goCart"
  />

  <!-- 第 28 轮 7.8：金刚区（最多 8 个分类，按件数降序；纯 emoji + 文字，不引任何图片资源） -->
  <view class="kk" wx:if="{{kingkong.length}}">
    <view
      class="kkitem"
      wx:for="{{kingkong}}"
      wx:key="name"
      data-cat="{{item.name}}"
      bindtap="onKingKong"
    >
      <view class="kkico">{{item.emoji}}</view>
      <view class="kkname">{{item.name}}</view>
    </view>
  </view>

  <!-- 第 28 轮 7.3：热销 6 件（与搜索无结果推荐共用同一个接口） -->
  <view class="hotsec" wx:if="{{!loading && !loadErr && hots.length}}">
    <view class="hot-h">
      <text>热销好物</text>
      <text class="hot-more" bindtap="goCategory">全部分类 ›</text>
    </view>
    <view class="grid">
      <view
        class="gitem"
        wx:for="{{hots}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="goDetail"
      >
        <view class="gthumb">
          <image wx:if="{{item.img}}" class="gimg" src="{{item.img}}" mode="aspectFill" lazy-load />
          <text wx:else>{{item.emoji}}</text>
          <view class="gtag hot" wx:if="{{item.stock > 0}}">热销</view>
          <view class="gtag out" wx:else>缺货</view>
        </view>
        <view class="gbody">
          <view class="gname">{{item.name}}</view>
          <view class="gspec">{{item.spec || item.brand || item.category}}</view>
          <view class="gfoot">
            <view class="gprice"><text class="gsym">¥</text>{{tools.fix2(item.salePrice)}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <van-skeleton wx:if="{{loading}}" title row="6" />

  <!-- 第 27 轮 P0-2：请求失败给错误卡 + 「重新加载」，绝不渲染成「没货」 -->
  <view class="errbox" wx:elif="{{loadErr}}">
    <view class="errico">📡</view>
    <view class="errmsg">{{loadErr}}</view>
    <view class="errsub">东西还在，只是这会儿没连上店里系统</view>
    <view class="errbtn" bindtap="reload">重新加载</view>
  </view>

  <!-- 双列网格 -->
  <view class="grid" wx:elif="{{!empty}}">
    <view
      class="gitem"
      wx:for="{{products}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="goDetail"
    >
      <view class="gthumb">
        <image wx:if="{{item.img}}" class="gimg" src="{{item.img}}" mode="aspectFill" lazy-load />
        <text wx:else>{{item.emoji}}</text>
        <view class="gtag out" wx:if="{{item.stock <= 0}}">缺货</view>
        <view class="gtag low" wx:elif="{{item.stock <= lowStock}}">仅剩 {{item.stock}} 件</view>
        <view class="gtag" wx:elif="{{item.isWholesale}}">批发</view>
      </view>
      <view class="gbody">
        <view class="gname">{{item.name}}</view>
        <view class="gspec">{{item.spec || item.brand || item.category}}</view>
        <view class="gfoot">
          <view class="gprice">
            <text class="gsym">¥</text>{{tools.fix2(item.salePrice)}}
            <text class="gori" wx:if="{{item.tier === 'wholesale' || item.tier === 'vip'}}">¥{{tools.fix2(item.retailPrice)}}</text>
          </view>
          <view
            class="gadd {{item.stock <= 0 ? 'dis' : ''}}"
            data-code="{{item.code}}"
            catchtap="onAdd"
          >+</view>
        </view>
      </view>
    </view>
  </view>

  <van-empty wx:if="{{!loading && !loadErr && empty}}" description="没有找到商品，换个词试试" />

  <view class="more" wx:if="{{!loading && total > 0}}">{{hasMore ? '上拉看更多' : '—— 没有更多了 ——'}}</view>

  <!-- 底部购物车条 -->
  <view class="cartbar" wx:if="{{cartCount > 0}}" bindtap="goCart">
    <view class="cb-left">购物车 <text class="cb-num">{{cartCount}}</text> 件 · ¥{{cartAmountText}}</view>
    <view class="cb-go">去结算</view>
  </view>
</view>
