@import "../../styles/state.wxss";

/* 首页 */
.shopbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}
.sb-name { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.sb-sub { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }
/* 连接状态：一个小圆点（样式在 app.wxss 的 .cdot，这里只管位置），不再显示「后端已连接」这种开发信息 */
.sdot {
  margin: 6rpx 6rpx 0 16rpx;
  align-self: flex-start;
}

.searchbar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.sbox {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  margin-right: 12rpx;
}
.sph { font-size: 26rpx; color: #9ca3af; margin-left: 10rpx; }

.kwbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 14rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}
.kwt { font-size: 24rpx; color: #374151; }
.kwx { font-size: 24rpx; color: #16a34a; padding: 4rpx 10rpx; }

van-notice-bar { margin-bottom: 16rpx; border-radius: 14rpx; overflow: hidden; }

.more {
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
  padding: 24rpx 0 180rpx;
}

/* 第 28 轮：金刚区（纯 emoji + 文字，不引任何图片资源） */
.kk {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 8rpx 6rpx;
  margin-bottom: 20rpx;
}
.kkitem {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22rpx;
}
.kkico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0fdf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
}
.kkname {
  font-size: 23rpx;
  color: #374151;
  margin-top: 10rpx;
  max-width: 150rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 第 28 轮：热销 6 件 */
.hotsec { margin-bottom: 8rpx; }
.hot-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  padding: 8rpx 4rpx 16rpx;
}
.hot-more { font-size: 22rpx; font-weight: 400; color: #16a34a; }
.gtag.hot { background: #16a34a; color: #fff; }
