<view class="page">
  <view class="bar">
    <view class="badge {{online ? 'ok' : 'off'}}">{{statusLabel}}</view>
    <view class="muted">共 {{orders.length}} 单</view>
  </view>

  <view class="empty" wx:if="{{!orders.length && !loading}}">还没有订单，去首页逛逛吧</view>

  <view class="section" wx:for="{{orders}}" wx:key="id">
    <view class="row">
      <view class="muted">{{item.createdText}}</view>
      <view class="pill st-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="row"><view class="oid">{{item.id}}</view></view>
    <view class="items">{{item.summary}}</view>
    <view class="row">
      <view class="muted">{{item.deliveryText}}{{item.address ? ' · ' + item.address : ''}}</view>
      <view class="total">¥{{item.totalText}}</view>
    </view>
    <view class="row muted" style="font-size:22rpx">商品 ¥{{item.subtotalText}} + 配送费 ¥{{item.feeText}}</view>
    <view class="ops">
      <view class="btn btn-ghost" data-id="{{item.id}}" bindtap="onReorder">再来一单</view>
      <view class="btn btn-ghost" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" bindtap="onCancel">取消订单</view>
    </view>
  </view>
</view>
