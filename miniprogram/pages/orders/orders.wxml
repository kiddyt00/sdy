<wxs src="../../utils/tools.wxs" module="tools" />
<view class="opage">
  <view class="obar">
    <view class="otitle">我的订单</view>
    <view class="cdot {{online ? 'ok' : 'off'}}"></view>
  </view>

  <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#16a34a" line-width="40rpx" swipe-threshold="{{6}}" sticky>
    <van-tab wx:for="{{tabs}}" wx:key="key" title="{{item.label}}" />
  </van-tabs>

  <van-skeleton wx:if="{{loading}}" title row="4" />

  <!-- 第 27 轮 P0-2：失败给「重新加载」，只有请求成功且为空才说「还没有订单」 -->
  <view class="errbox" wx:elif="{{loadErr}}">
    <view class="errico">📡</view>
    <view class="errmsg">{{loadErr}}</view>
    <view class="errsub">你的订单都在店里，只是这会儿没连上店里系统</view>
    <view class="errbtn" bindtap="reload">重新加载</view>
  </view>

  <!-- 第 27 轮 P0-8：订单接口要带身份，没身份先在页面拦住并引导 -->
  <view class="errbox" wx:elif="{{needIdentity}}">
    <view class="errico">🔑</view>
    <view class="errmsg">先登录或填收货手机号，才能看订单</view>
    <view class="errsub">订单按手机号/微信归到你名下，没身份分不清是谁的</view>
    <view class="errbtn" bindtap="reload">我已登录，重新加载</view>
  </view>

  <van-empty wx:elif="{{empty}}" description="这里还没有订单">
    <van-button round type="primary" size="small" bind:click="goIndex">去逛逛</van-button>
  </van-empty>

  <view class="olist" wx:else>
    <view class="ocard" wx:for="{{orders}}" wx:key="id">
      <view class="ohead" data-id="{{item.id}}" bindtap="goDetail">
        <view class="oid">单号 {{item.id}}</view>
        <view class="ostatus s-{{item.status}}">{{item.statusText}}</view>
      </view>

      <view class="oitems" data-id="{{item.id}}" bindtap="goDetail">
        <view class="oitem" wx:for="{{item.items}}" wx:for-item="g" wx:key="code">
          <view class="othumb">🛒</view>
          <view class="oinfo">
            <view class="oname">{{g.name}}</view>
            <view class="ospec">¥{{tools.fix2(g.price)}} × {{g.qty}}</view>
          </view>
          <view class="oamt">¥{{tools.fix2(g.amount)}}</view>
        </view>
      </view>

      <view class="ohint">{{item.hint}}</view>

      <view class="ofoot">
        <view class="ometa">
          <text>{{item.createdText}}</text>
          <text class="odot">·</text>
          <text>{{item.deliveryText}}</text>
          <text class="odot">·</text>
          <text>{{item.count}} 件</text>
        </view>
        <view class="osum">合计 <text class="osum-n">¥{{item.totalText}}</text></view>
      </view>

      <view class="oacts">
        <view class="obtn ghost" wx:if="{{item.canCancel}}" data-id="{{item.id}}" bindtap="onCancel">取消订单</view>
        <view class="obtn primary" wx:if="{{item.canAdvance}}" data-id="{{item.id}}" bindtap="onAdvance">确认收货</view>
        <view class="obtn line" wx:if="{{item.canReorder}}" data-id="{{item.id}}" bindtap="onReorder">再来一单</view>
        <view class="obtn line" data-id="{{item.id}}" bindtap="goDetail">看详情</view>
      </view>
    </view>
  </view>
</view>
