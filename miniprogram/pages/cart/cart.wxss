/* 购物车（第 24 轮） */
.cartpage { padding-bottom: 260rpx; }

.chead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 18rpx;
}
.ctitle { font-size: 34rpx; font-weight: 700; }
.cnum { font-size: 24rpx; color: #6b7280; font-weight: 400; }

van-notice-bar { margin-bottom: 16rpx; border-radius: 14rpx; overflow: hidden; }

/* 行 */
.clist { background: #fff; border-radius: 20rpx; padding: 4rpx 20rpx; }
.crow {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.crow:last-child { border-bottom: none; }
.cgrow { flex: 1; margin-left: 12rpx; min-width: 0; }
.cinner { display: flex; align-items: center; }
.cthumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex: none;
  overflow: hidden;
}
.cimg { width: 100%; height: 100%; }
.cinfo { flex: 1; padding-left: 20rpx; min-width: 0; }
.cname {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 38rpx;
  max-height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.cspec { font-size: 22rpx; color: #9ca3af; margin-top: 6rpx; }
.cfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.cprice { color: #dc2626; font-weight: 700; font-size: 30rpx; }
.cunit { font-size: 20rpx; color: #9ca3af; font-weight: 400; }

.cdel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #dc2626;
  color: #fff;
  font-size: 26rpx;
  padding: 0 34rpx;
}

/* 配送方式 */
.dways { display: flex; }
.dway {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  color: #4b5563;
  font-size: 28rpx;
}
.dway:first-child { margin-right: 16rpx; }
.dway.on { border-color: #16a34a; color: #16a34a; background: #eff6ff; font-weight: 600; }

.addrbtns { display: flex; margin-top: 14rpx; }
.addrbtns .btn { margin-right: 16rpx; }

.sumpad { height: 20rpx; }

/* 结算条 */
.cbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, .06);
  z-index: 50;
}
.cbar-l { display: flex; align-items: center; }
.clink { font-size: 24rpx; color: #16a34a; margin-left: 20rpx; }
.cbar-r { display: flex; align-items: center; }
.cbar-sum { text-align: right; margin-right: 20rpx; }
.cbar-hint { display: block; font-size: 20rpx; color: #9ca3af; }
.cbar-n { font-size: 36rpx; font-weight: 700; color: #dc2626; }
.cbar-go {
  background: #16a34a;
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 40rpx;
  font-size: 29rpx;
  font-weight: 600;
}
.cbar-go.dis { background: #9ca3af; }
