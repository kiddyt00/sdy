<view class="mpage">
  <view class="mhead">
    <view class="mavatar-wrap">
      <image wx:if="{{avatar}}" class="mavatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="mavatar ph">🙂</view>
      <button class="mavatar-hit" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
    </view>
    <view class="mwho">
      <view class="mname">{{loggedIn ? (sessionName || '微信顾客') : '还没登录'}}</view>
      <view class="msub">{{loggedIn ? sessionLabel : '点头像即可用微信头像'}}</view>
      <view class="mtier">{{tierText}}</view>
    </view>
    <view class="mdot {{online ? 'ok' : 'off'}}"></view>
  </view>

  <view class="mcard login" wx:if="{{!loggedIn}}">
    <view class="ltitle">微信登录</view>
    <input class="linput" type="nickname" value="{{nickname}}" maxlength="20" placeholder="微信昵称（点上面头像可选微信头像）" placeholder-class="lph" bindinput="onNickname" />
    <van-button round block type="primary" loading="{{busy}}" bind:click="doLogin">微信一键登录</van-button>
    <view class="lhint">登录后就用你的微信头像和昵称，不用再填、也不用保存。登录不用手机号——手机号只在下单填收货信息时用，等级与批发价由老板在后台设定。</view>
  </view>

  <view class="mgrid">
    <view class="gcell" wx:for="{{orderGrid}}" wx:key="key" data-key="{{item.key}}" bindtap="goOrdersWith">
      <view class="gicon">
        <van-icon name="{{item.icon}}" size="44rpx" color="#16a34a" />
        <view class="gdot" wx:if="{{counts[item.key] > 0}}">{{counts[item.key]}}</view>
      </view>
      <view class="glabel">{{item.label}}</view>
    </view>
  </view>

  <view class="mcard">
    <van-cell title="全部订单" icon="orders-o" is-link bind:click="goOrders" />
    <van-cell title="收货地址" icon="location-o" is-link bind:click="goAddress" />
    <van-cell title="购物车" icon="shopping-cart-o" is-link bind:click="goCart" value="{{cartCount > 0 ? cartCount + ' 件' : ''}}" />
    <van-cell title="联系店家" icon="phone-o" is-link bind:click="callShop" />
  </view>

  <view class="mcard">
    <van-cell title="店铺" value="{{shop.name}}" />
    <van-cell title="营业时间" value="{{shop.hours}}" />
    <van-cell title="门店说明" label="{{shop.notice}}" />
  </view>

  <view class="mcard" wx:if="{{devMode}}">
    <view class="dtitle">开发者选项</view>
    <view class="drow">{{statusDetail}}</view>
    <van-field value="{{apiBase}}" label="后端地址" placeholder="http://127.0.0.1:8093" bind:change="onBase" />
    <view class="dbtns">
      <van-button size="small" round type="primary" bind:click="saveBase">保存并重连</van-button>
      <van-button size="small" round plain bind:click="clearAll">清空本地缓存</van-button>
      <van-button wx:if="{{loggedIn}}" size="small" round plain bind:click="doLogout">退出登录</van-button>
    </view>
  </view>

  <view class="mfoot">
    <text class="mf-ver">啥都有快送 · 小程序 0.4.0</text>
    <text class="mf-dev" bindtap="toggleDev">开发者选项</text>
  </view>
</view>
