/* 我的（第 24 轮重构；第 25 轮 D31：头像真圆、登录不绑手机号） */
.mpage { padding-bottom: 60rpx; }

.mhead {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #16a34a, #22c55e);
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
/* 头像必须是正圆：button 自带 padding / 行高 / ::after 边框，
   不重置的话 128rpx 的盒子会被撑成长方形，border-radius:50% 就成了椭圆（第 25 轮修复）。 */
.mavatar-btn {
  width: 128rpx;
  height: 128rpx;
  min-width: 128rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  flex: none;
  line-height: 1;
  font-size: 0;
  box-sizing: border-box;
  background: rgba(255, 255, 255, .18);
}
.mavatar-btn::after { border: none; }
.mavatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}
.mavatar.ph {
  line-height: 128rpx;
  text-align: center;
  font-size: 60rpx;
}
.mwho { flex: 1; padding-left: 26rpx; min-width: 0; }
.mname { color: #fff; font-size: 36rpx; font-weight: 700; }
.msub { color: rgba(255, 255, 255, .86); font-size: 23rpx; margin-top: 10rpx; }
.mtier {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #065f46;
  background: #dcfce7;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
/* 连接状态只留一个小点：绿=后端在线，灰=本地演示模式（文案在开发者选项里看） */
.mdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
  margin-left: 16rpx;
  align-self: flex-start;
  margin-top: 10rpx;
}
.mdot.ok { background: #4ade80; box-shadow: 0 0 0 6rpx rgba(255, 255, 255, .22); }
.mdot.off { background: #d1d5db; }

.mcard {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  overflow: hidden;
  padding: 6rpx 0;
}
.mcard.login { padding: 28rpx; }
.ltitle { font-size: 28rpx; font-weight: 700; margin-bottom: 20rpx; }
.linput {
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  margin-bottom: 18rpx;
}
.lph { color: #b6bac2; }
.lhint { font-size: 21rpx; color: #9ca3af; line-height: 32rpx; margin-top: 18rpx; }

.mgrid {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 26rpx 0;
}
.gcell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gicon { position: relative; }
.gdot {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 0 6rpx;
}
.glabel { font-size: 23rpx; color: #4b5563; margin-top: 12rpx; }

.dtitle { font-size: 27rpx; font-weight: 700; padding: 20rpx 24rpx 8rpx; }
.drow { font-size: 22rpx; color: #9ca3af; padding: 0 24rpx 16rpx; word-break: break-all; }
.dbtns {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 20rpx 20rpx;
}

.mfoot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
}
.mf-ver { font-size: 22rpx; color: #b6bac2; }
.mf-dev { font-size: 22rpx; color: #b6bac2; margin-top: 10rpx; text-decoration: underline; }
