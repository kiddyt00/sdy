/* 我的（第 24 轮重构；第 25 轮 D31：头像真圆、登录不绑手机号）
   第 25 轮收口④：登录搬进绿色框（删掉下面那张独立登录卡）、头像不再可点（去掉「更换头像」）、
   退出登录后头像必须清空——所以 .mhead 改成纵向两段：身份行 .mrow + 登录行 .mlogin。 */
.mpage { padding-bottom: 60rpx; }

.mhead {
  padding: 40rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #16a34a, #22c55e);
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
/* 身份行：头像 + 昵称/等级 + 连接小点（且只在这一行） */
.mrow { display: flex; align-items: center; }
/* 头像必须是正圆。第 25 轮踩过两次坑：只要把原生 button 当可见圆形容器，
   它自带的 padding / 行高 / ::after 边框就会把 128rpx 的盒子撑扁成椭圆。
   现在头像这一层是纯 view/image（不再套 button，也不再可点），椭圆问题从根上消失。 */
.mavatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, .18);
}
.mavatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}
.mavatar.ph {
  line-height: 128rpx;
  text-align: center;
  font-size: 60rpx;
}
.mwho { flex: 1; padding-left: 26rpx; min-width: 0; }
.mname { color: #fff; font-size: 36rpx; font-weight: 700; }
.msub { color: rgba(255, 255, 255, .86); font-size: 23rpx; margin-top: 10rpx; }
.mtier {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #065f46;
  background: #dcfce7;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
/* 连接状态只留一个小点：绿=后端在线，灰=本地演示模式（文案在开发者选项里看） */
.mdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
  margin-left: 16rpx;
  align-self: flex-start;
  margin-top: 10rpx;
}
.mdot.ok { background: #4ade80; box-shadow: 0 0 0 6rpx rgba(255, 255, 255, .22); }
.mdot.off { background: #d1d5db; }

.mcard {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  overflow: hidden;
  padding: 6rpx 0;
}
/* 绿色框里的登录行：昵称输入（微信会给真实昵称建议）+ 登录按钮（同时也是微信头像选择按钮） */
.mlogin { margin-top: 30rpx; }
/* 身份选择（第 26 轮 / D32）：顾客 / 员工，选中那个用实心白底 */
.lroles { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.lrole {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, .22);
  border: 2rpx solid rgba(255, 255, 255, .6);
}
.lrole.on { background: #fff; color: #15803d; font-weight: 600; border-color: #fff; }
.lnick {
  height: 76rpx;
  line-height: 76rpx;
  background: rgba(255, 255, 255, .95);
  border-radius: 38rpx;
  padding: 0 32rpx;
  font-size: 27rpx;
  color: #1f2937;
}
.lnick-ph { color: #9ca3af; }
.lbtn {
  margin-top: 18rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border: none;
  border-radius: 42rpx;
  background: #fff;
  color: #15803d;
  font-size: 30rpx;
  font-weight: 600;
}
.lbtn::after { border: none; }
.lbtn[disabled] { background: #fff; color: #15803d; opacity: .65; }
.ltip { margin-top: 18rpx; font-size: 21rpx; line-height: 34rpx; color: rgba(255, 255, 255, .9); }

.mgrid {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 26rpx 0;
}
.gcell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gicon { position: relative; }
.gdot {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 0 6rpx;
}
.glabel { font-size: 23rpx; color: #4b5563; margin-top: 12rpx; }

.mfoot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
}
.mf-ver { font-size: 22rpx; color: #b6bac2; }
/* 退出登录（第 25 轮收口③）：从「开发者选项」里挪出来，顾客该有的正常入口。
   第 25 轮收口⑤：调试面板（含长按版本号入口）已按老板要求整块删除——顾客端没有任何开发入口。 */
.mexit {
  text-align: center;
  font-size: 28rpx;
  color: #dc2626;
  padding: 26rpx 0;
}
