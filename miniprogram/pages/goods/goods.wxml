<wxs src="../../utils/tools.wxs" module="tools" />
<view class="gpage">
  <van-skeleton wx:if="{{loading}}" title row="8" />

  <!-- 第 27 轮 P0-2：请求失败给错误卡 + 「重新加载」，不冒充「已下架」 -->
  <view class="errbox" wx:elif="{{err}}">
    <view class="errico">📡</view>
    <view class="errmsg">{{err}}</view>
    <view class="errsub">这件货还在，只是这会儿没连上店里系统</view>
    <view class="errbtn" bindtap="reload">重新加载</view>
  </view>

  <van-empty wx:elif="{{notFound}}" description="{{notFound}}">
    <van-button round type="primary" size="small" bind:click="goHome">回首页看看</van-button>
  </van-empty>

  <block wx:else>
    <!-- 大图 -->
    <view class="hero" bindtap="previewImg">
      <image wx:if="{{p.img}}" class="hero-img" src="{{p.img}}" mode="aspectFill" />
      <text wx:else class="hero-emoji">{{p.emoji}}</text>
      <view class="hero-tag" wx:if="{{p.isWholesale}}">批发有优惠</view>
    </view>

    <!-- 价格卡 -->
    <view class="pcard">
      <view class="pline">
        <view class="pprice">
          <text class="psym">¥</text>{{tools.fix2(p.salePrice)}}
          <text class="punit">/ {{p.unit}}</text>
        </view>
        <van-tag wx:if="{{tierHint}}" type="primary" plain>{{tierHint}}</van-tag>
      </view>
      <view class="pori" wx:if="{{(p.tier === 'wholesale' || p.tier === 'vip') && p.wholesalePrice > 0}}">
        零售价 ¥{{tools.fix2(p.retailPrice)}}
      </view>
      <view class="pname">{{p.name}}</view>
      <view class="pmeta">
        <text wx:if="{{p.brand}}">{{p.brand}}</text>
        <text wx:if="{{p.spec}}">{{p.spec}}</text>
        <text>{{p.category}}</text>
      </view>
      <!-- 第 27 轮 P0-9：低库存阈值来自服务端（页面 data.lowStock ← api.lowStock()），不写死 -->
      <view class="pstock {{p.stock <= 0 ? 'zero' : ''}}">
        {{p.stock <= 0 ? '暂时缺货，补货后再来' : (p.stock <= lowStock ? '仅剩 ' + p.stock + p.unit : '现货 ' + p.stock + p.unit)}}
      </view>
    </view>

    <!-- 数量 -->
    <view class="qcard">
      <text class="qlabel">购买数量</text>
      <van-stepper
        wx:if="{{p.stock > 0}}"
        value="{{qty}}"
        min="1"
        max="{{p.stock}}"
        integer
        button-size="30px"
        bind:change="onStep"
      />
      <text wx:else class="muted">缺货中</text>
    </view>

    <!-- 店铺信息 -->
    <view class="scard">
      <view class="srow">
        <van-icon name="shop-o" size="34rpx" color="#16a34a" />
        <text class="sname">{{shop.name || '啥都有快送'}}</text>
      </view>
      <view class="saddr muted" wx:if="{{shop.address}}">{{shop.address}}</view>
      <view class="saddr muted" wx:if="{{shop.phone}}">电话 {{shop.phone}}</view>
      <view class="shint muted">下单后可选择送货上门或到店自提，缺货商品会被老板电话确认。</view>
    </view>

    <!-- 第 28 轮 7.4：缺货时给「同类推荐」（最多 5 件，后端优先同分类热销）；有货不显示这一块 -->
    <view class="altcard" wx:if="{{p.stock <= 0 && alts.length}}">
      <view class="alt-h">缺货了，看看这些</view>
      <view class="altitem" wx:for="{{alts}}" wx:key="code" data-code="{{item.code}}" bindtap="goAlt">
        <view class="altthumb">
          <image wx:if="{{item.img}}" class="altimg" src="{{item.img}}" mode="aspectFill" lazy-load />
          <text wx:else>{{item.emoji}}</text>
        </view>
        <view class="altinfo">
          <view class="altname">{{item.name}}</view>
          <view class="altspec">{{item.spec || item.brand || item.category || '—'}}</view>
          <view class="altprice"><text class="altsym">¥</text>{{tools.fix2(item.salePrice)}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部动作条 -->
  <view class="gbarbox" wx:if="{{!loading && !err}}">
    <view class="gcart" bindtap="goCart">
      <van-icon name="cart-o" size="46rpx" color="#4b5563" />
      <text class="gcart-n" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
    <van-goods-action>
      <van-goods-action-button
        color="#16a34a"
        type="warning"
        text="加入购物车"
        disabled="{{p.stock <= 0}}"
        bind:click="addCart"
      />
      <van-goods-action-button
        color="#15803d"
        type="danger"
        text="{{p.stock > 0 ? '立即购买' : '缺货'}}"
        disabled="{{p.stock <= 0}}"
        bind:click="buyNow"
      />
    </van-goods-action>
  </view>
</view>
